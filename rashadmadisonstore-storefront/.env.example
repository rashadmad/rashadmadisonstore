# Copy to .env.local and fill in. Never commit real values.

# Backend (Medusa) address
MEDUSA_BACKEND_URL=http://localhost:9000
# Required. Create in the Medusa admin: Settings > Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=us

# Payments (Stripe publishable key, starts with pk_)
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=

# Optional: analytics and images
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# Optional: Mastodon blog feed and cross-posting (server-only secrets)
MASTODON_API_BASE_URL=
MASTODON_ACCOUNT_ACCT=
MASTODON_ACCESS_TOKEN=
NEXT_PUBLIC_MASTODON_PROFILE_URL=
BLOG_CROSSPOST_KEY=

# Optional: also forward signups to the newsletter app (server-only). Signups are always saved in Medusa.
NEWSLETTER_SIGNUP_URL=
NEWSLETTER_SIGNUP_KEY=
